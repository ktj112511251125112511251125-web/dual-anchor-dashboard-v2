# ==========================================
# V14 99/1 account settings
# ANCHOR account_config.env와 분리해서 사용
# 숫자는 쉼표 없이 입력하세요. 예: 10000, 20.5, 0.6
# ==========================================

V14_CASH=6409

V14_QQQ_SHARES=0
